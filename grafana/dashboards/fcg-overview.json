      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(fcg_library_additions_total)",
          "legendFormat": "total",
          "refId": "A"
        }
      ]
    }
